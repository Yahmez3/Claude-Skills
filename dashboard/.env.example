# Choose one provider (or set multiple). The dashboard does not store keys —
# it reads them from this file via python-dotenv at startup.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Where the dashboard's own state (run registry SQLite) lives.
DASHBOARD_DB_PATH=./runs.db

# Optional: override TradingAgents data/log roots
# TRADINGAGENTS_RESULTS_DIR=
# TRADINGAGENTS_CACHE_DIR=
# TRADINGAGENTS_MEMORY_LOG_PATH=
